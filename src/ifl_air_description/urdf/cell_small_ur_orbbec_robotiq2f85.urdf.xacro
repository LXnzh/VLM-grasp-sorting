<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="cell_small_ur_orbbec_robotiq2f85">
  
  <!-- Import macros -->
  <xacro:include filename="$(find ifl_air_description)/urdf/ur_orbbec_robotiq2f85_macro.urdf.xacro"/>
  <xacro:include filename="$(find ifl_air_description)/urdf/robotertisch_1520x900_macro.urdf.xacro"/>
  <xacro:include filename="$(find ifl_air_description)/urdf/robotertisch_kameraaufsatz_macro.urdf.xacro"/>
  <xacro:include filename="$(find ifl_air_description)/urdf/robotertisch_800x1400_macro.urdf.xacro"/>
  <xacro:include filename="$(find ifl_air_description)/urdf/robotertisch_virtual_macro.urdf.xacro"/>
  <xacro:include filename="$(find ifl_air_description)/urdf/roboter_oberdecke_macro.urdf.xacro"/>
  

  <!-- create link fixed to the "world" -->
  <link name="world" />

  <xacro:arg name="joint_limit_params" default="$(find ifl_air_cell_small_ur_orbbec_robotiq_moveit_config)/config/joint_limits.yaml"/>

  <xacro:robotertisch_1520x900 prefix="" parent="world" child="cell_origin"/>

  <!-- possible fingertype: default, custom_75, custom_160 -->
  <!-- possible mount_orbbec: true, false -->
  <xacro:ur_orbbec_robotiq prefix="" parent="cell_origin" finger_type="default" mount_orbbec="false">
    <origin xyz="0.3 0.2 0" rpy="0 0 ${-pi/2}"/>
  </xacro:ur_orbbec_robotiq>

  <xacro:roboter_oberdecke prefix="" parent="world" rotation="${pi/2}">
    <origin xyz="-0.45 -0.76 2.2" rpy="0 0 0"/>
  </xacro:roboter_oberdecke>


  <!-- Static collision-only box-->
  <link name="wall1_obstacle_box">
    <collision>
      <!-- collision geometry is centered at the link frame -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 2.0 2.0"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 2.0 2.0"/>
      </geometry>
      <material name="GrayTransparent">
        <!-- R G B A -->
        <color rgba="0.5 0.5 0.5 0.2"/>
      </material>
    </visual>
    <!-- no <visual> on purpose -->
  </link>

  <joint name="wall1_obstacle_box_fixed" type="fixed">
    <parent link="world"/>
    <child link="wall1_obstacle_box"/>
    <origin xyz="0.4 -0.4 1.0" rpy="0 0 0"/>
  </joint>

  <link name="wall2_obstacle_box">
    <collision>
      <!-- collision geometry is centered at the link frame -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 2.0 2.0"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 2.0 2.0"/>
      </geometry>
      <material name="GrayTransparent">
        <!-- R G B A -->
        <color rgba="0.5 0.5 0.5 0.2"/>
      </material>
    </visual>
    <!-- no <visual> on purpose -->
  </link>

  <joint name="wall2_obstacle_box_fixed" type="fixed">
    <parent link="world"/>
    <child link="wall2_obstacle_box"/>
    <origin xyz="-1.3 -0.4 1.0" rpy="0 0 0"/>
  </joint>

  <link name="wall3_obstacle_box">
    <collision>
      <!-- collision geometry is centered at the link frame -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 0.1 2.0"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 0.1 2.0"/>
      </geometry>
      <material name="GrayTransparent">
        <!-- R G B A -->
        <color rgba="0.5 0.5 0.5 0.2"/>
      </material>
    </visual>
    <!-- no <visual> on purpose -->
  </link>

  <joint name="wall3_obstacle_box_fixed" type="fixed">
    <parent link="world"/>
    <child link="wall3_obstacle_box"/>
    <origin xyz="-0.45 0.65 1.0" rpy="0 0 0"/>
  </joint>

  <link name="static_camera_obstacle_box">
    <collision>
      <!-- collision geometry is centered at the link frame -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.18 0.8"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.18 0.8"/>
      </geometry>
      <material name="GrayTransparent">
        <!-- R G B A -->
        <color rgba="0.5 0.5 0.5 0.2"/>
      </material>
    </visual>
    <!-- no <visual> on purpose -->
  </link>

  <joint name="static_camera_obstacle_box_fixed" type="fixed">
    <parent link="world"/>
    <child link="static_camera_obstacle_box"/>
    <origin xyz="-0.08 -1.43 1.3" rpy="0 0 0"/>
  </joint>

</robot>
