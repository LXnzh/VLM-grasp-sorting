<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="ur_mountingplate" params="prefix parent child *origin">

    <joint name="${prefix}ur_mountingplate_joint" type="fixed">
      <!-- The parent link must be read from the robot model it is attached to. -->
      <parent link="${parent}"/>
      <child link="${prefix}ur_mountingplate_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}ur_mountingplate_link">
        <visual>
          <origin xyz="0 0 0.0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://ifl_air_description/meshes/visual/mountingplate_200x200_simlab.dae"/>
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0 0.0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://ifl_air_description/meshes/collision/mountingplate_200x200_m.stl"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="2" />
          <origin xyz="0 0 0" />
          <inertia ixx="8.432e-3" ixy="3.804169e-6" ixz="7.00981e-7" iyy="8.460e-3" iyz="-8.41529e-7" izz="1.606e-2" />
        </inertial>
    </link>

    <joint name="${prefix}ur_mountingplate_base_joint" type="fixed">
      <parent link="${prefix}ur_mountingplate_link"/>
      <child link="${child}"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </joint>
    <link name="${child}"/>

  </xacro:macro>

  <!-- 15 mm variant (scaled in Z) -->
  <xacro:macro name="ur_mountingplate_15mm" params="prefix parent child *origin">

    <joint name="${prefix}ur_mountingplate_15mm_joint" type="fixed">
      <!-- The parent link must be read from the robot model it is attached to. -->
      <parent link="${parent}"/>
      <child link="${prefix}ur_mountingplate_15mm_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}ur_mountingplate_15mm_link">
        <visual>
          <!-- link frame at plate bottom; center geometry at half thickness -->
          <origin xyz="0 0 0.0075" rpy="0 0 0" />
          <geometry>
            <box size="0.24 0.24 0.015"/>
          </geometry>
          <material name="iron">
            <color rgba="0.35 0.36 0.38 1.0"/>
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0.0075" rpy="0 0 0"/>
          <geometry>
            <box size="0.24 0.24 0.015"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="2" />
          <origin xyz="0 0 0" />
          <inertia ixx="8.432e-3" ixy="3.804169e-6" ixz="7.00981e-7" iyy="8.460e-3" iyz="-8.41529e-7" izz="1.606e-2" />
        </inertial>
    </link>

    <joint name="${prefix}ur_mountingplate_15mm_base_joint" type="fixed">
      <parent link="${prefix}ur_mountingplate_15mm_link"/>
      <child link="${child}"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>
    <link name="${child}"/>

  </xacro:macro>
</robot>
